generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Produto {
  id        Int      @id @default(autoincrement())
  nome      String
  preco     Float
  estoque   Int      @default(0)
  imagem    String?
  categoria String   @default("Periféricos")
  descricao String?  @db.Text
  criadoEm  DateTime @default(now())
}